# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.
# Every key is optional: a missing key turns that feature off gracefully.
# Without the two Supabase keys, email capture is off: the Playbook and
# templates become plain downloads (no email field) and the newsletter form is
# hidden. Visitors never see a "not connected" message.

# --- Supabase (form submissions; task 17) ---
# Project Settings → API. The service role key is SECRET: server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (confirmation emails; task 18) ---
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "First Offer Academy <hello@firstofferacademy.com>"
EMAIL_FROM=
# Where new-application alerts go
NOTIFY_EMAIL=
# Resend → Audience → Segments → Copy ID. Signups are added to this segment
# (set it for Production AND Preview).
RESEND_SEGMENT_ID=

# --- Download links (Playbook PDF and templates) ---
# Signs the download cookie and the ?t= link in the confirmation email.
# Optional: falls back to SUPABASE_SERVICE_ROLE_KEY. Any long random string.
DOWNLOAD_SECRET=

# --- Stripe ---
# Nothing to set. Payments use Stripe payment links from content/site.ts
# (site.stripe), and the post-payment redirect to /enrolled is configured in
# the Stripe dashboard.

# --- Admin (/admin; task 20). Leave either empty to disable /admin entirely. ---
ADMIN_USER=
ADMIN_PASSWORD=
